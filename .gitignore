# Layout note: directories are separated by what an update does to them.
#   web/ server/ services/ scripts/   code, replaced on update
#   config/ assets/                   user data, never touched
#   runtime/ var/                     downloaded or regenerated

# Model weights, third-party checkouts and bundled binaries. Tens of
# gigabytes, all of it re-downloadable. See docs/03-user-guide.md for where
# each piece comes from, and docs/04-packaging.md for the measured sizes.
/runtime/

# User-supplied avatar assets: VRM models, Live2D packages, motion clips,
# reference footage. Individually large and all of it comes from elsewhere.
/assets/

# Voice samples are the exception: they are small, and the default character
# does not work without its reference clip.
!/assets/voices/
!/assets/voices/*.wav

# Logs, recordings and the prepared-avatar cache. Safe to delete at any time.
/var/

# Local secrets: llm.json holds provider API keys.
/config/llm.json

# Rust build output. Regenerated by cargo, hundreds of MB.
/app/target/
/spike/*/target/

# The shell binary, copied to the root by scripts\build-shell.ps1.
/mate.exe

# Scratch.
/download/
__pycache__/
*.pyc
*.bak
