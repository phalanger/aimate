# Layout note: directories are separated by what an update does to them.
#   web/ server/ services/ scripts/   code, replaced on update
#   config/ assets/                   user data, never touched
#   runtime/ var/                     downloaded or regenerated

# Model weights, third-party checkouts and bundled binaries. Tens of
# gigabytes, all of it re-downloadable. See docs/03-user-guide.md for where
# each piece comes from, and docs/04-packaging.md for the measured sizes.
/runtime/

# User-supplied avatar assets: VRM models, Live2D packages, motion clips,
# reference footage. Individually large and all of it comes from elsewhere.
/assets/

# Reference clips were the exception here until this repository went public.
# They are small, but a clip used for voice cloning is someone's voice, and the
# right to publish one is not ours to assume. install.ps1 copies the sample
# that ships inside the speech_to_speech package into assets/voices/ instead,
# so a fresh clone still speaks on the first run without this repository
# redistributing any audio of its own.

# Logs, recordings and the prepared-avatar cache. Safe to delete at any time.
/var/

# Local secrets: providers.json holds the API keys in plain text.
#
# This rule used to name llm.json. That file was renamed to providers.json and
# the rule was not, so for 32 commits the keys were tracked - they went in with
# the initial commit and were only found on 2026-07-30. History has been
# rewritten to drop the file, and both keys rotated. If this file is ever
# renamed again, change this line in the same commit.
#
# config/providers.example.json is the tracked copy: same shape, no keys.
/config/providers.json

# The other two config files are personal rather than secret: characters carry
# whatever persona you wrote for them, and the voice library points at your own
# reference clips by absolute path. Neither is useful to anyone else and both
# would land in every commit you make. The .example.json copies are tracked;
# install.ps1 seeds the real ones from them on a fresh clone.
#
# settings.json used to stay tracked, on the grounds that it is the list of
# what is adjustable and the panel renders itself from it. But the panel also
# writes your values back into that same file, so every slider you moved turned
# up as a modification to a tracked file - and the value shipped for the cloud
# proxy was one machine's loopback address, useful to nobody else.
#
# It is now created from config/settings.example.json on first run. New
# settings added to the template are merged into the live file on startup,
# values already there untouched, so untracking it does not mean updates stop
# arriving. See sync_settings_from_template in server/server.py.
/config/characters.json
/config/voices.json
/config/settings.json

# Live2D Cubism Core is proprietary. Its own header calls it "Redistributable
# Code", but redistribution is governed by an agreement this project has not
# entered on anyone's behalf, so it is fetched by install.ps1 from Live2D
# instead of vendored here. three.js and three-vrm are MIT and stay.
/web/vendor/live2d/live2dcubismcore.min.js

# Rust build output. Regenerated by cargo, hundreds of MB. The bare /target/ is
# rust-analyzer's, which it creates at the workspace root rather than beside
# the crate.
/app/target/
/spike/*/target/
/target/

# The shell binary, copied to the root by scripts\build-shell.ps1.
/mate.exe

# Scratch.
/download/
__pycache__/
*.pyc
*.bak
# Left behind when a file is edited in place with a backup.
*.orig
